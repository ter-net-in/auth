# Production env for auth.ter.net.in.
# Fill this in and paste it into the GitHub Actions secret PRODUCTION_ENV
# (the deploy workflow writes it to .env on the server).
#
# Inside docker-compose the DB host is the service name `postgres`.

DATABASE_URL=postgres://authkit:CHANGE_ME@postgres:5432/authkit
POSTGRES_USER=authkit
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=authkit

BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=https://auth.ter.net.in
COOKIE_DOMAIN=.ter.net.in
TRUSTED_ORIGINS=https://ter.net.in,https://*.ter.net.in
ADMIN_EMAILS=you@ter.net.in
TRUSTED_OAUTH_CLIENT_IDS=

# Host port docker-compose binds on 127.0.0.1 — pick one free on the box so it
# doesn't clash with other apps. Caddy (infra/Caddyfile) proxies auth.ter.net.in here.
WEB_PORT=3000
