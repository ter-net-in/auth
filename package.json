{
  "name": "authkit",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "bun --filter '@ternetin/db' generate",
    "db:migrate": "bun --filter '@ternetin/db' migrate",
    "db:studio": "bun --filter '@ternetin/db' studio",
    "dev:web": "bun --filter '@ternetin/web' dev",
    "dev": "bun run dev:web"
  },
  "devDependencies": {
    "@types/bun": "^1.2.16",
    "concurrently": "^9.2.1",
    "typescript": "^5.8.3",
    "@biomejs/biome": "^2.4.15"
  }
}
