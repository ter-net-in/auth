{
  "name": "authkit",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "bun --filter '@ternetin/db' generate",
    "db:migrate": "bun --filter '@ternetin/db' migrate",
    "db:studio": "bun --filter '@ternetin/db' studio",
    "dev:web": "bun --filter '@ternetin/web' dev",
    "dev": "bun run dev:web",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "1.3.14",
    "concurrently": "^9.2.5",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
