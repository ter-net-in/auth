{
  "name": "@ternetin/oauth",
  "version": "0.1.0",
  "description": "Plug-and-play Better Auth plugin to sign in through auth.ter.net.in (OIDC).",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "better-auth": ">=1.7.0"
  },
  "devDependencies": {
    "better-auth": "^1.2.12",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "better-auth",
    "oauth",
    "oidc",
    "sso",
    "ternetin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
